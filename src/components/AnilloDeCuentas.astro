---
// Diez cuentas y la del Padre Nuestro (abajo). El reproductor marca cada una
// como rezada, actual o pendiente con data-estado.
const C = 100;
const R = 74;
const cuentas = Array.from({ length: 11 }, (_, k) => {
  const ang = ((90 + k * (360 / 11)) * Math.PI) / 180;
  return { k, x: C + R * Math.cos(ang), y: C + R * Math.sin(ang), r: k === 0 ? 11 : 7.5 };
});
---

<button type="button" class="anillo" data-anillo aria-label="Siguiente cuenta">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <circle cx={C} cy={C} r={R} class="hilo"></circle>
    {
      cuentas.map((c) => (
        <g data-cuenta={c.k} data-estado="pendiente">
          <circle cx={c.x} cy={c.y} r={c.r + 6} class="halo" />
          <circle cx={c.x} cy={c.y} r={c.r} class="cuenta" />
        </g>
      ))
    }
  </svg>
  <span class="centro">
    <span class="contador" data-contador></span>
    <span class="etiqueta" data-contador-pie></span>
  </span>
</button>

<style>
  .anillo {
    position: relative;
    display: block;
    width: 200px;
    height: 200px;
    margin: var(--esp-6) auto 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--tinta);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hilo {
    fill: none;
    stroke: var(--veta);
    stroke-width: 1.5;
  }
  .cuenta {
    fill: var(--fondo);
    stroke: var(--cuenta-pendiente);
    stroke-width: 1.5;
    transition: fill 250ms ease, stroke 250ms ease;
  }
  .halo {
    fill: var(--cuenta-actual);
    opacity: 0;
    transition: opacity 250ms ease;
  }
  [data-estado='rezada'] .cuenta {
    fill: var(--cuenta-rezada);
    stroke: var(--cuenta-rezada);
  }
  [data-estado='actual'] .cuenta {
    fill: var(--cuenta-actual);
    stroke: var(--cuenta-actual);
  }
  [data-estado='actual'] .halo {
    opacity: 0.25;
  }
  g {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* La cuenta actual respira una vez al avanzar. */
  .respira {
    animation: respira 600ms ease-in-out;
  }
  @keyframes respira {
    50% {
      transform: scale(1.25);
    }
  }
  .centro {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .centro .etiqueta {
    margin-top: var(--esp-1);
  }
</style>
